{
  "name": "RevYne AI",
  "short_name": "RevYne",
  "description": "AI review assistant for honest customer feedback and business replies.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "categories": ["business", "productivity"],
  "background_color": "#F8F9FF",
  "theme_color": "#8127CF",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.revyneai.app"
    }
  ],
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "protocol_handlers": [
    {
      "protocol": "web+revyne",
      "url": "/?link=%s"
    }
  ],
  "share_target": {
    "action": "/?share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Create Review Link",
      "short_name": "Review Link",
      "description": "Open your business profile and review link tools.",
      "url": "/#business",
      "icons": [
        {
          "src": "/assets/revyne-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Smart Reply",
      "short_name": "AI Reply",
      "description": "Generate professional replies to customer reviews.",
      "url": "/#reply",
      "icons": [
        {
          "src": "/assets/revyne-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Help & Support",
      "short_name": "Support",
      "description": "Raise or review support tickets.",
      "url": "/#support",
      "icons": [
        {
          "src": "/assets/revyne-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshot-mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "RevYne AI mobile dashboard"
    },
    {
      "src": "/assets/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "RevYne AI review assistant workspace"
    }
  ],
  "icons": [
    {
      "src": "/assets/revyne-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/revyne-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
